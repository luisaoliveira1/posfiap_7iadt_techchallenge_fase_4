# ─── Azure AI Speech ────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=speech_key
AZURE_SPEECH_REGION=brazilsouth

# ─── Azure Blob Storage ─────────────────────────────────────────────────────────
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_BLOB_AUDIO_CONTAINER=audio-uploads
AZURE_BLOB_TRANSCRIPT_CONTAINER=transcripts
AZURE_BLOB_RESULTS_CONTAINER=results

# ─── Internal service URLs (Docker Compose) ───────────────────────────────
NLP_MODEL_URL=http://nlp-model:8001
RISK_ENGINE_URL=http://risk-engine:8002

# ─── Speech-to-text backend ─────────────────────────────────────────────────────
# "whisper" → OpenAI Whisper local (gratuito, ~150MB de download, roda em CPU)
# "azure"   → Azure AI Speech SDK (precisa do AZURE_SPEECH_KEY)
# "none"    → desabilita upload de áudio, use /api/audio/analyze-text com JSON para testar sem áudio
STT_BACKEND=whisper

# ─── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─── Azure AI Foundry (human-in-the-loop) ───────────────────────────────────────
AI_FOUNDRY_ENDPOINT=https://your-foundry-workspace.api.azureml.ms
AI_FOUNDRY_SUBSCRIPTION_ID=subscription-id
AI_FOUNDRY_RESOURCE_GROUP=ppd-rg
AI_FOUNDRY_WORKSPACE_NAME=ppd-foundry
